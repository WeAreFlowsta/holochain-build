+/// Return `true` if the store holds any scheduled-function row at all, for any
+/// author. The scheduler asks this once per tick before it visits each cell.
+pub(crate) async fn any_scheduled_functions<'e, E>(executor: E) -> sqlx::Result<bool>
+where
+    E: Executor<'e, Database = Sqlite>,
+{
+    let row: (i64,) = sqlx::query_as("SELECT EXISTS (SELECT 1 FROM ScheduledFunction)")
+        .fetch_one(executor)
+        .await?;
+    Ok(row.0 != 0)
+}
