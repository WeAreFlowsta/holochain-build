+/// Whether the author's committed source chain holds an action of
+/// `action_type`.
+///
+/// Restricted to accepted rows, as [`get_actions_by_author`] is. The
+/// `Action(author, seq)` index walks the author's chain from its start and
+/// stops at the first match.
+pub(crate) async fn author_has_action_of_type<'e, E>(
+    executor: E,
+    author: &AgentPubKey,
+    action_type: i64,
+) -> sqlx::Result<bool>
+where
+    E: Executor<'e, Database = Sqlite>,
+{
+    sqlx::query_scalar(
+        "SELECT EXISTS (SELECT 1 FROM Action
+                        WHERE author = ? AND record_validity = ? AND action_type = ?)",
+    )
+    .bind(author.get_raw_36())
+    .bind(i64::from(RecordValidity::Accepted))
+    .bind(action_type)
+    .fetch_one(executor)
+    .await
+}
