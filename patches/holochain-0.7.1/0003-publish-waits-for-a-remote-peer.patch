+
+/// Whether the peer store of the cell's space holds a reachable agent that is
+/// not one of this conductor's own cells. When the store cannot be read the
+/// answer is yes, and the publish workflow decides.
+async fn any_remote_peer(conductor: &ConductorHandle, cell_id: &CellId) -> bool {
+    let Ok(peer_store) = conductor
+        .holochain_p2p()
+        .peer_store(cell_id.dna_hash().clone())
+        .await
+    else {
+        return true;
+    };
+    let Ok(agents) = peer_store.get_all().await else {
+        return true;
+    };
+    let local: std::collections::HashSet<_> = conductor
+        .running_cell_ids()
+        .into_iter()
+        .filter(|id| id.dna_hash() == cell_id.dna_hash())
+        .map(|id| id.agent_pubkey().to_k2_agent())
+        .collect();
+    agents
+        .iter()
+        .any(|a| !a.is_tombstone && a.url.is_some() && !local.contains(&a.agent))
+}
