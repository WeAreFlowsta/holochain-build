+/// Return `true` if `author` has an ephemeral scheduled-function row whose
+/// `start_at` is at or before `now`: the rows that
+/// [`delete_live_ephemeral_scheduled_functions`] would delete.
+pub(crate) async fn has_live_ephemeral_scheduled_functions<'e, E>(
+    executor: E,
+    author: &AgentPubKey,
+    now: Timestamp,
+) -> sqlx::Result<bool>
+where
+    E: Executor<'e, Database = Sqlite>,
+{
+    let row: (i64,) = sqlx::query_as(
+        "SELECT EXISTS (
+            SELECT 1 FROM ScheduledFunction
+            WHERE ephemeral = 1 AND author = ? AND start_at <= ?
+         )",
+    )
+    .bind(author.get_raw_36())
+    .bind(now.as_micros())
+    .fetch_one(executor)
+    .await?;
+    Ok(row.0 != 0)
+}
+
 /// Delete every ephemeral scheduled-function row in the store, regardless of
 /// author or liveness. Returns the number of rows deleted.
 ///
@@ -421,4 +445,78 @@ mod tests {
