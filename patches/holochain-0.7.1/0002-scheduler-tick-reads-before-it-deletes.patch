+
+    #[tokio::test]
+    async fn delete_live_ephemeral_with_nothing_to_delete() {
+        let db = test_open_db(dht_id()).await.unwrap();
+        let alice = agent(1);
+        let bob = agent(2);
+        let payload = b"x";
+
+        // Nothing scheduled at all.
+        assert_eq!(
+            db.delete_live_ephemeral_scheduled_functions(&alice, Timestamp::from_micros(150))
+                .await
+                .unwrap(),
+            0
+        );
+
+        // Rows that must not count: Alice's persisted row, Alice's ephemeral
+        // row that starts later, and Bob's eligible ephemeral row.
+        for (author, name, start, ephemeral) in [
+            (&alice, "persisted", 100, false),
+            (&alice, "later", 200, true),
+            (&bob, "bobs", 100, true),
+        ] {
+            db.upsert_scheduled_function(InsertScheduledFunction {
+                author,
+                zome_name: "z",
+                scheduled_fn: name,
+                maybe_schedule: payload,
+                start_at: Timestamp::from_micros(start),
+                end_at: Timestamp::from_micros(300),
+                ephemeral,
+            })
+            .await
+            .unwrap();
+        }
+        assert_eq!(
+            db.delete_live_ephemeral_scheduled_functions(&alice, Timestamp::from_micros(150))
+                .await
+                .unwrap(),
+            0
+        );
+        for (author, name) in [(&alice, "persisted"), (&alice, "later"), (&bob, "bobs")] {
+            assert!(db
+                .as_ref()
+                .is_function_scheduled(author, "z", name)
+                .await
+                .unwrap());
+        }
+
+        // An ephemeral row past its `end_at` is still deleted: the delete
+        // looks at `start_at` only.
+        db.upsert_scheduled_function(InsertScheduledFunction {
+            author: &alice,
+            zome_name: "z",
+            scheduled_fn: "expired",
+            maybe_schedule: payload,
+            start_at: Timestamp::from_micros(100),
+            end_at: Timestamp::from_micros(120),
+            ephemeral: true,
+        })
+        .await
+        .unwrap();
+        assert_eq!(
+            db.delete_live_ephemeral_scheduled_functions(&alice, Timestamp::from_micros(150))
+                .await
+                .unwrap(),
+            1
+        );
+        assert!(!db
+            .as_ref()
+            .is_function_scheduled(&alice, "z", "expired")
+            .await
+            .unwrap());
+    }
