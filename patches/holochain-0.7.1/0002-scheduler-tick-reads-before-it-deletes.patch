+++ b/crates/holochain_data/src/dht/db_operations/scheduled_function.rs
@@ -72,6 +72,16 @@ impl DbWrite<Dht> {
         author: &AgentPubKey,
         now: Timestamp,
     ) -> sqlx::Result<u64> {
+        // The scheduler calls this for every cell on every tick. A read that
+        // finds nothing to delete costs far less than a delete that finds nothing.
+        {
+            let mut conn = self.as_ref().timed_conn().await?;
+            if !scheduled_function::has_live_ephemeral_scheduled_functions(&mut *conn, author, now)
+                .await?
+            {
+                return Ok(0);
+            }
+        }
         scheduled_function::delete_live_ephemeral_scheduled_functions(self.pool(), author, now)
             .await
     }
