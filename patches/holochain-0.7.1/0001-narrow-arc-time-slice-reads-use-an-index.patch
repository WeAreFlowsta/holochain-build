+/// Create the index that the narrow-arc time-slice reads in
+/// `dht::inner::sync_queries` are pinned to.
+///
+/// It is created here and not in a migration, so the set of applied
+/// migrations stays the one a build without this change expects, and such a
+/// build can still open the database (it ignores the extra index).
+async fn ensure_narrow_arc_index(pool: &Pool<Sqlite>, db_kind: kind::DbKind) -> sqlx::Result<()> {
+    if matches!(db_kind, kind::DbKind::Dht) {
+        sqlx::query(
+            "CREATE INDEX IF NOT EXISTS ChainOp_storage_center_loc_narrow_arc
+                ON ChainOp(storage_center_loc)",
+        )
+        .execute(pool)
+        .await?;
+    }
+    Ok(())
+}
