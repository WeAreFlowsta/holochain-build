+/// Arcs narrower than this (1/64 of the location space) are read through the
+/// `ChainOp_storage_center_loc_narrow_arc` index. Kitsune2 asks for one DHT
+/// sector (1/512 of the space) at a time, 512 times per update, and without
+/// the index each of those reads scans every action in the store. Wider arcs
+/// and wrapping arcs keep the scan, which is the faster plan for them.
+const NARROW_ARC_WIDTH: u32 = 1 << 26;
+
+/// [`op_hashes_in_time_slice`] for a narrow, non-wrapping arc. Same rows as
+/// the general statement; the chain-op branch starts from the location index.
+const NARROW_ARC_TIME_SLICE_SQL: &str = "
+    SELECT op_hash AS hash, basis_hash, serialized_size, sort_ts FROM (
+        SELECT
+            ChainOp.hash AS op_hash,
+            ChainOp.basis_hash AS basis_hash,
+            ChainOp.serialized_size AS serialized_size,
+            Action.timestamp AS sort_ts
+        FROM ChainOp INDEXED BY ChainOp_storage_center_loc_narrow_arc
+        JOIN Action ON ChainOp.action_hash = Action.hash
+        WHERE
+            ChainOp.storage_center_loc >= ?
+            AND ChainOp.storage_center_loc <= ?
+            AND Action.timestamp >= ?
+            AND Action.timestamp <  ?
+            AND ChainOp.locally_validated = 1
+            AND (ChainOp.op_type != 2 OR Action.private_entry = 0)
+        UNION ALL
+        SELECT
+            Warrant.hash AS op_hash,
+            Warrant.warrantee AS basis_hash,
+            WarrantOp.serialized_size AS serialized_size,
+            Warrant.timestamp AS sort_ts
+        FROM Warrant
+        JOIN WarrantOp ON WarrantOp.hash = Warrant.hash
+        WHERE
+            WarrantOp.storage_center_loc >= ?
+            AND WarrantOp.storage_center_loc <= ?
+            AND Warrant.timestamp >= ?
+            AND Warrant.timestamp <  ?
+    )
+    ORDER BY sort_ts ASC
+";
+
+/// [`earliest_authored_timestamp_in_arc`] for a narrow, non-wrapping arc.
+const NARROW_ARC_EARLIEST_SQL: &str = "
+    SELECT MIN(ts) FROM (
+        SELECT Action.timestamp AS ts
+        FROM ChainOp INDEXED BY ChainOp_storage_center_loc_narrow_arc
+        JOIN Action ON ChainOp.action_hash = Action.hash
+        WHERE
+            ChainOp.storage_center_loc >= ?
+            AND ChainOp.storage_center_loc <= ?
+            AND ChainOp.locally_validated = 1
+            AND (ChainOp.op_type != 2 OR Action.private_entry = 0)
+        UNION ALL
+        SELECT Warrant.timestamp AS ts
+        FROM Warrant
+        JOIN WarrantOp ON WarrantOp.hash = Warrant.hash
+        WHERE
+            WarrantOp.storage_center_loc >= ?
+            AND WarrantOp.storage_center_loc <= ?
+    )
+";
+
 impl ArcBounds {
+    /// Non-wrapping and narrow enough for the location index to win.
+    fn is_narrow(self) -> bool {
+        self.start <= self.end && self.end - self.start < NARROW_ARC_WIDTH
+    }
     fn start_i64(self) -> i64 {
         self.start as i64
     }
